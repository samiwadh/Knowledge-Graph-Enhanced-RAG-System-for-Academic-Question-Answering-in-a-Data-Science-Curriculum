@prefix ns1: <http://unimib-ds-assistant.org/> .

ns1:DataManagement ns1:covers ns1:GraphDatabase,
        ns1:MongoDB,
        ns1:NoSQL .

ns1:DataSemantics ns1:covers ns1:KnowledgeGraph,
        ns1:Ontology,
        ns1:RDF,
        ns1:SPARQL .

ns1:MachineLearning ns1:covers ns1:Classification,
        ns1:Clustering,
        ns1:Overfitting .

ns1:GraphDatabase ns1:implementedBy ns1:Neo4j .

